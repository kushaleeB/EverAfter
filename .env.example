# EverAfter — root environment (loaded by server/src/config/env.js)
# Copy to .env and fill in values:  cp .env.example .env

PORT=3001
NODE_ENV=development

# PostgreSQL via Prisma ORM (Supabase)
# Copy from Supabase → Project Settings → Database → ORM / Prisma tab
#
# Runtime (transaction pooler, port 6543) — used by the API on Railway:
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
#
# Migrations & Prisma CLI (session pooler, port 5432):
# DIRECT_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
#
# Local dev fallback (direct connection):
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=your-64-char-access-secret-here-change-in-production
JWT_REFRESH_SECRET=your-64-char-refresh-secret-here-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Password reset
PASSWORD_RESET_EXPIRES_HOURS=1
APP_URL=http://localhost:5173

# CORS (comma-separated for multiple origins, e.g. local + production frontend)
CORS_ORIGIN=http://localhost:5173

# Uploads
# local = server/uploads/ (default for local dev)
# supabase = ever-after bucket (requires SUPABASE_SERVICE_ROLE_KEY)
# auto = local in development, supabase in production
UPLOAD_STORAGE=local
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# Supabase Storage — bucket name: ever-after
# Project URL is auto-derived from DATABASE_URL if omitted.
# SUPABASE_PROJECT_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=ever-after

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Guest invitation email (Resend recommended)
# EMAIL_PROVIDER=console|resend|sendgrid|brevo
EMAIL_PROVIDER=console
EMAIL_FROM=EverAfter <invitations@everafter.com>
# EMAIL_API_KEY=re_xxxxxxxx

# Google OAuth (OAuth 2.0 Web client — authorized origin: http://localhost:5173)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Demo account (created by `npm run db:seed`)
# Email: demo@everafter.app
# Password: Demo1234!

# ─── Frontend (Vite) — use .env.local for local-only overrides ───────────────
# Copy: cp .env.example .env && create .env.local for Vite vars
#
# Local dev (npm run dev): Vite proxies /api and /uploads → localhost:3001
# Do not set VITE_API_BASE_URL locally.
#
# Test against Railway API from local frontend:
# VITE_API_PROXY_TARGET=https://your-api.up.railway.app

# Production frontend build (Railway / Vercel) — full API URL, no trailing slash
# VITE_API_BASE_URL=https://your-api.up.railway.app/api/v1

# ─── Railway (production API) ───────────────────────────────────────────────
# Set these in the Railway service dashboard (Root Directory: server).
# NODE_ENV=production
# PORT is injected automatically by Railway — do not set manually.
# DATABASE_URL=postgresql://postgres.REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres.REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# JWT_ACCESS_SECRET=...                  (64+ char random hex)
# JWT_REFRESH_SECRET=...                 (64+ char random hex)
# APP_URL=https://your-frontend-url      (Vercel / production SPA URL)
# CORS_ORIGIN=https://your-frontend-url,http://localhost:5173
# SUPABASE_SERVICE_ROLE_KEY=...                 (Settings → API → service_role)
# SUPABASE_STORAGE_BUCKET=ever-after
# UPLOAD_STORAGE=supabase                         (required in production)
# Make bucket public in Supabase Storage → ever-after → Configuration
