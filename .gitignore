# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules/

# ─── Environment & secrets ───────────────────────────────────────────────────
.env
.env.*
!.env.example

# ─── Build output ────────────────────────────────────────────────────────────
dist/
build/
*.tsbuildinfo

# ─── Logs & debug ────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Runtime / uploads ───────────────────────────────────────────────────────
server/uploads/*
!server/uploads/.gitkeep

# ─── Prisma ──────────────────────────────────────────────────────────────────
server/prisma/*.db
server/prisma/*.db-journal

# ─── OS & editor ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ─── IDE (keep shared settings, ignore personal) ─────────────────────────────
.idea/
*.swp
*.swo
*~

# ─── Test & coverage ─────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ─── Misc ────────────────────────────────────────────────────────────────────
.cache/
.temp/
tmp/
*.local
