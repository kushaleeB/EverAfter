generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email               String               @db.Citext
  passwordHash        String               @map("password_hash") @db.VarChar(255)
  firstName           String               @map("first_name") @db.VarChar(100)
  lastName            String               @map("last_name") @db.VarChar(100)
  avatarUrl           String?              @map("avatar_url")
  role                UserRole             @default(customer)
  emailVerifiedAt     DateTime?            @map("email_verified_at") @db.Timestamptz(6)
  lastLoginAt         DateTime?            @map("last_login_at") @db.Timestamptz(6)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?            @map("deleted_at") @db.Timestamptz(6)
  googleId            String?              @unique @map("google_id") @db.VarChar(255)
  collaborators       EventCollaborator[]
  ownedEvents         Event[]              @relation("EventOwner")
  uploadedMedia       MediaAsset[]
  passwordResetTokens PasswordResetToken[]
  subscriptions       Subscription[]
  sessions            UserSession[]

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model SubscriptionPlan {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String               @db.VarChar(100)
  slug              String               @unique @db.VarChar(50)
  description       String?
  priceCents        Int                  @default(0) @map("price_cents")
  currency          String               @default("USD") @db.Char(3)
  billingInterval   BillingInterval      @default(monthly) @map("billing_interval")
  maxInvitations    Int?                 @map("max_invitations")
  maxGuestsPerEvent Int?                 @map("max_guests_per_event")
  maxStorageMb      Int?                 @map("max_storage_mb")
  maxCollaborators  Int?                 @default(2) @map("max_collaborators")
  features          Json                 @default("[]")
  isActive          Boolean              @default(true) @map("is_active")
  isFeatured        Boolean              @default(false) @map("is_featured")
  sortOrder         Int                  @default(0) @map("sort_order")
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  templates         InvitationTemplate[]
  subscriptions     Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String             @map("user_id") @db.Uuid
  planId             String             @map("plan_id") @db.Uuid
  status             SubscriptionStatus @default(trialing)
  currentPeriodStart DateTime?          @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd   DateTime?          @map("current_period_end") @db.Timestamptz(6)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  plan               SubscriptionPlan   @relation(fields: [planId], references: [id])
  user               User               @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("subscriptions")
}

model UserSession {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  refreshToken String    @unique @map("refresh_token") @db.VarChar(512)
  userAgent    String?   @map("user_agent")
  ipAddress    String?   @map("ip_address") @db.Inet
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

model InvitationTemplate {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String            @db.VarChar(150)
  slug            String            @unique @db.VarChar(100)
  description     String?
  previewImageUrl String            @map("preview_image_url")
  themeConfig     Json              @default("{}") @map("theme_config")
  defaultSections Json              @default("[]") @map("default_sections")
  minPlanSlug     String?           @map("min_plan_slug") @db.VarChar(50)
  isActive        Boolean           @default(true) @map("is_active")
  isPremium       Boolean           @default(false) @map("is_premium")
  sortOrder       Int               @default(0) @map("sort_order")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  plan            SubscriptionPlan? @relation(fields: [minPlanSlug], references: [slug])
  invitations     Invitation[]

  @@map("invitation_templates")
}

model Event {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId       String              @map("owner_id") @db.Uuid
  title         String              @db.VarChar(255)
  partnerOne    String?             @map("partner_one") @db.VarChar(100)
  partnerTwo    String?             @map("partner_two") @db.VarChar(100)
  eventDate     DateTime?           @map("event_date") @db.Date
  eventTimezone String              @default("UTC") @map("event_timezone") @db.VarChar(64)
  venueName     String?             @map("venue_name") @db.VarChar(255)
  venueAddress  String?             @map("venue_address")
  coverImageUrl String?             @map("cover_image_url")
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?           @map("deleted_at") @db.Timestamptz(6)
  collaborators EventCollaborator[]
  owner         User                @relation("EventOwner", fields: [ownerId], references: [id])
  guests        Guest[]
  invitations   Invitation[]
  mediaAssets   MediaAsset[]

  @@index([ownerId])
  @@map("events")
}

model EventCollaborator {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId    String           @map("event_id") @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  role       CollaboratorRole @default(viewer)
  invitedAt  DateTime         @default(now()) @map("invited_at") @db.Timestamptz(6)
  acceptedAt DateTime?        @map("accepted_at") @db.Timestamptz(6)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  event      Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@map("event_collaborators")
}

model Invitation {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId           String              @map("event_id") @db.Uuid
  templateId        String?             @map("template_id") @db.Uuid
  slug              String              @db.VarChar(100)
  status            InvitationStatus    @default(draft)
  headline          String?             @db.VarChar(255)
  subheadline       String?
  bodyContent       String?             @map("body_content")
  themeConfig       Json                @default("{}") @map("theme_config")
  rsvpDeadline      DateTime?           @map("rsvp_deadline") @db.Date
  passwordProtected Boolean             @default(false) @map("password_protected")
  publishedAt       DateTime?           @map("published_at") @db.Timestamptz(6)
  viewCount         BigInt              @default(0) @map("view_count")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?           @map("deleted_at") @db.Timestamptz(6)
  sections          InvitationSection[]
  event             Event               @relation(fields: [eventId], references: [id])
  template          InvitationTemplate? @relation(fields: [templateId], references: [id])
  media             MediaAsset[]
  rsvps             Rsvp[]

  @@index([eventId])
  @@index([slug])
  @@map("invitations")
}

model InvitationSection {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invitationId String      @map("invitation_id") @db.Uuid
  sectionType  SectionType @map("section_type")
  sortOrder    Int         @default(0) @map("sort_order")
  content      Json        @default("{}")
  isVisible    Boolean     @default(true) @map("is_visible")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?   @map("deleted_at") @db.Timestamptz(6)
  invitation   Invitation  @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId])
  @@map("invitation_sections")
}

model Guest {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId        String        @map("event_id") @db.Uuid
  email          String?       @db.Citext
  firstName      String        @map("first_name") @db.VarChar(100)
  lastName       String        @map("last_name") @db.VarChar(100)
  role           GuestRole     @default(guest)
  category       GuestCategory @default(other)
  partySize      Int           @default(1) @map("party_size")
  plusOneAllowed Boolean       @default(false) @map("plus_one_allowed")
  accessToken    String            @unique @map("access_token") @db.VarChar(64)
  inviteStatus   GuestInviteStatus @default(not_sent) @map("invite_status")
  inviteSentAt   DateTime?         @map("invite_sent_at") @db.Timestamptz(6)
  inviteOpenedAt DateTime?         @map("invite_opened_at") @db.Timestamptz(6)
  respondedAt    DateTime?         @map("responded_at") @db.Timestamptz(6)
  notes          String?
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?     @map("deleted_at") @db.Timestamptz(6)
  event          Event         @relation(fields: [eventId], references: [id])
  rsvps          Rsvp[]

  @@index([eventId])
  @@index([eventId, category])
  @@map("guests")
}

model Rsvp {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  guestId        String     @map("guest_id") @db.Uuid
  invitationId   String     @map("invitation_id") @db.Uuid
  status         RsvpStatus @default(pending)
  attendingCount Int        @default(0) @map("attending_count")
  dietaryNotes   String?    @map("dietary_notes")
  message        String?
  respondedAt    DateTime?  @map("responded_at") @db.Timestamptz(6)
  ipAddress      String?    @map("ip_address") @db.Inet
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  guest          Guest      @relation(fields: [guestId], references: [id])
  invitation     Invitation @relation(fields: [invitationId], references: [id])

  @@unique([guestId, invitationId])
  @@index([invitationId])
  @@index([invitationId, status])
  @@map("rsvps")
}

model MediaAsset {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId       String         @map("event_id") @db.Uuid
  uploadedBy    String?        @map("uploaded_by") @db.Uuid
  invitationId  String?        @map("invitation_id") @db.Uuid
  fileName      String         @map("file_name") @db.VarChar(255)
  fileUrl       String         @map("file_url")
  storageKey    String         @unique @map("storage_key") @db.VarChar(512)
  mimeType      String         @map("mime_type") @db.VarChar(100)
  assetType     MediaAssetType @default(image) @map("asset_type")
  fileSizeBytes BigInt         @default(0) @map("file_size_bytes")
  altText       String?        @map("alt_text") @db.VarChar(255)
  sortOrder     Int            @default(0) @map("sort_order")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?      @map("deleted_at") @db.Timestamptz(6)
  event         Event          @relation(fields: [eventId], references: [id])
  invitation    Invitation?    @relation(fields: [invitationId], references: [id])
  uploader      User?          @relation(fields: [uploadedBy], references: [id])

  @@index([eventId])
  @@map("media_assets")
}

enum UserRole {
  customer
  admin

  @@map("user_role")
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  canceled
  expired

  @@map("subscription_status")
}

enum BillingInterval {
  monthly
  yearly
  lifetime

  @@map("billing_interval")
}

enum InvitationStatus {
  draft
  published
  archived

  @@map("invitation_status")
}

enum SectionType {
  hero
  story
  schedule
  gallery
  rsvp
  registry
  custom

  @@map("section_type")
}

enum GuestInviteStatus {
  not_sent
  sent
  opened
  responded

  @@map("guest_invite_status")
}

enum GuestRole {
  host
  partner
  planner
  guest

  @@map("guest_role")
}

enum GuestCategory {
  family
  friends
  colleagues
  vip
  wedding_party
  other

  @@map("guest_category")
}

enum RsvpStatus {
  pending
  attending
  declined
  maybe

  @@map("rsvp_status")
}

enum CollaboratorRole {
  owner
  partner
  planner
  viewer

  @@map("collaborator_role")
}

enum MediaAssetType {
  image
  video
  document

  @@map("media_asset_type")
}
